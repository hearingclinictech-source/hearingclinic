# E2E Test Environment Configuration
# Copy this file to .env and update with your credentials

# Test Environment: development, staging, or production
TEST_ENV=development

# Optional: Override base URL (otherwise uses TEST_ENV config)
# BASE_URL=http://development.localhost:8000

# Development Environment Credentials
# These will be used even for TEST_ENV=development
ADMIN_USER=Administrator
ADMIN_PASSWORD=your_dev_admin_password

# Or use DEV_ prefix for development-specific credentials
# DEV_ADMIN_USER=Administrator
# DEV_ADMIN_PASSWORD=your_dev_admin_password
# DEV_MANAGER_USER=test.manager@hearingclinic.local
# DEV_MANAGER_PASSWORD=test123

# Staging Environment Credentials
STAGING_ADMIN_USER=Administrator
STAGING_ADMIN_PASSWORD=your_staging_admin_password

STAGING_MANAGER_USER=test.manager@hearingclinic.com
STAGING_MANAGER_PASSWORD=your_staging_manager_password

STAGING_SALES_USER=test.sales@hearingclinic.com
STAGING_SALES_PASSWORD=your_staging_sales_password

STAGING_ACCOUNTANT_USER=test.accountant@hearingclinic.com
STAGING_ACCOUNTANT_PASSWORD=your_staging_accountant_password

# Production Environment Credentials (use with extreme caution!)
PROD_BASE_URL=https://your-production-url.com
PROD_ADMIN_USER=
PROD_ADMIN_PASSWORD=
PROD_MANAGER_USER=
PROD_MANAGER_PASSWORD=

# Testomat.io API Key (for test reporting)
TESTOMATIO=your_testomatio_api_key
