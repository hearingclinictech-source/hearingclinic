{
  "name": "hearingclinic",
  "version": "0.0.1",
  "description": "ERPNext customization app for Hearing Clinic operations",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:testomat": "npx check-tests@latest jest '**/*.{js,ts}' --update-ids",
    "test:testomat:report": "npx start-test-run -c 'npm test'",
    "test:testomat:import": "npx check-tests@latest jest '**/*.{js,ts}' --create",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": [
    "erpnext",
    "frappe",
    "hearing-clinic"
  ],
  "author": "Thomas Roch <thomas@dierochs.de>",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testomatio/reporter": "1.6.17",
    "dotenv": "17.4.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/frontend/**/test_*.js"
    ],
    "collectCoverageFrom": [
      "hearingclinic/public/js/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/hearingclinic/tests/frontend/setup.js"
    ],
    "reporters": [
      "default",
      "@testomatio/reporter/lib/adapter/jest.js"
    ]
  },
  "dependencies": {
    "check-tests": "0.15.5"
  }
}
